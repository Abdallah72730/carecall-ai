# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI — Groq primary, Cerebras fallback (both US-based, OpenAI-compatible).
# DeepSeek is intentionally not used: PRC data residency conflicts with
# PIPEDA cross-border disclosure and Alberta HIA expectations for the
# clinic custodians who deploy this service.
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Vapi
VAPI_API_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@carecallai.net

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PILOT_PRICE_ID=
STRIPE_STARTER_PRICE_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Sentry
SENTRY_DSN_BACKEND=

# App
FRONTEND_URL=https://app.carecallai.ca
TEST_CLINIC_ID=
SENTENCE_TRANSFORMERS_HOME=/tmp/models
